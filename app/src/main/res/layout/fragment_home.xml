<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="16dp" android:paddingBottom="12dp">
    <com.google.android.material.card.MaterialCardView android:id="@+id/connection_card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/transparent" app:contentPadding="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tv_fsoc_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="hello, friend." android:textSize="11sp" android:fontFamily="@font/jetbrains_mono" android:maxLines="1" android:includeFontPadding="false" android:layout_marginBottom="8dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_disconnected" android:textSize="34sp" android:fontFamily="@font/manrope_semibold" android:letterSpacing="-0.04" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="34sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                <TextView android:id="@+id/tv_fsoc_prompt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="[ VPN / OFF ]" android:textSize="12sp" android:fontFamily="@font/jetbrains_mono" android:visibility="gone" android:layout_marginEnd="12dp" />
                <TextView android:id="@+id/tv_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:fontFamily="@font/jetbrains_mono" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.smarttools.netguard.widget.ConnectionMapView android:id="@+id/home_map" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="12dp" android:visibility="gone" android:contentDescription="@string/connection_map_overview" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/server_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:contentDescription="@string/home_choose_server" app:cardCornerRadius="24dp" app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_servers" app:tint="?attr/colorOnSurfaceVariant" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_profile_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_profile_selected" android:textSize="16sp" android:fontFamily="@font/manrope_semibold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tv_profile_protocol" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_connect" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/connect" android:textSize="15sp" android:filterTouchesWhenObscured="true" app:icon="@drawable/ic_power" app:iconGravity="textStart" app:iconSize="18dp" app:cornerRadius="28dp" />
    <LinearLayout android:id="@+id/layout_action_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
        <FrameLayout android:id="@+id/layout_auto_select" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_auto_select" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auto_select" android:textSize="12sp" android:paddingHorizontal="4dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" />
            <ProgressBar android:id="@+id/progress_auto_select" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:id="@+id/layout_speed_test" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:visibility="gone" android:layout_marginStart="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_speed_test" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/speed_test" android:textSize="12sp" android:paddingHorizontal="4dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" />
            <ProgressBar android:id="@+id/progress_speed_test" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/layout_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:paddingVertical="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_download" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/tv_down_speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 B/s" android:fontFamily="@font/jetbrains_mono" android:textSize="24sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="24sp" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/tv_down_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_upload" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/tv_up_speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 B/s" android:fontFamily="@font/jetbrains_mono" android:textSize="24sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="24sp" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/tv_up_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:id="@+id/history_card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/transparent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/layout_session_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_details" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_today" android:minHeight="48dp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/tv_stats_today" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0 B" android:textSize="15sp" android:fontFamily="@font/jetbrains_mono" android:gravity="end" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="15sp" />
                <TextView android:id="@+id/tv_stats_week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
                <TextView android:id="@+id/tv_stats_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            </LinearLayout>
            <com.smarttools.netguard.widget.TrafficChartView android:id="@+id/traffic_chart" android:layout_width="match_parent" android:layout_height="58dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:id="@+id/tv_fsoc_quote" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/speed_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tv_speed_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/tv_speed_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/tv_speed_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_cancel_speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/speed_cancel" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>


