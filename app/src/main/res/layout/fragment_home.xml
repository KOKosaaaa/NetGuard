<?xml version="1.0" encoding="utf-8"?>
<!--
  Home — non-scrolling. Three vertical chains:
    TOP    — status text + optional map (anchored to parent top)
    CENTER — Connect button + timer + profile + action row (bias 0.5)
    BOTTOM — speed stats + traffic chart + session stats (anchored to parent bottom)
  Toggling map / chart / speed-test changes the size of their own band
  but never moves the Connect button. Sizes are roomy on purpose —
  there was 200+dp of unused vertical space in the previous pass.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- ====================== TOP band ====================== -->

    <TextView
        android:id="@+id/tv_fsoc_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="hello, friend."
        android:textSize="13sp"
        android:textStyle="italic"
        android:fontFamily="monospace"
        android:textColor="@color/fsoc_text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_disconnected"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_fsoc_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_fsoc_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="root@fsociety:~$ awaiting target"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="@color/fsoc_text_secondary"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.smarttools.netguard.widget.ConnectionMapView
        android:id="@+id/connection_map"
        android:layout_width="0dp"
        android:layout_height="135dp"
        android:visibility="gone"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tv_fsoc_prompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ==================== CENTER focal point ==================== -->

    <ImageButton
        android:id="@+id/btn_connect"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_power"
        android:scaleType="fitCenter"
        android:padding="40dp"
        android:background="@drawable/bg_button_disconnected"
        android:contentDescription="@string/connect"
        android:filterTouchesWhenObscured="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.38" />

    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="28sp"
        android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/btn_connect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_profile_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/no_profile_selected"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_timer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_action_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layout_auto_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auto_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_select"
                android:textSize="13sp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <ProgressBar
                android:id="@+id/progress_auto_select"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_speed_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginStart="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_speed_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed_test"
                android:textSize="13sp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <ProgressBar
                android:id="@+id/progress_speed_test"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_speed_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/layout_action_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_fsoc_quote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:gravity="center"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:textColor="@color/fsoc_text"
        android:background="#1F00FF41"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/tv_speed_result"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ==================== BOTTOM band ==================== -->

    <LinearLayout
        android:id="@+id/layout_session_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stats_today" android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/tv_stats_today" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 B" android:textSize="15sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stats_week" android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/tv_stats_week" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 B" android:textSize="15sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stats_total" android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/tv_stats_total" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 B" android:textSize="15sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <com.smarttools.netguard.widget.TrafficChartView
        android:id="@+id/traffic_chart"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/layout_session_stats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/traffic_chart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="\u2193" android:textSize="20sp" />
            <TextView android:id="@+id/tv_down_speed" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 B/s" android:textSize="16sp"
                android:fontFamily="monospace" />
            <TextView android:id="@+id/tv_down_total" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 B" android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="\u2191" android:textSize="20sp" />
            <TextView android:id="@+id/tv_up_speed" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 B/s" android:textSize="16sp"
                android:fontFamily="monospace" />
            <TextView android:id="@+id/tv_up_total" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 B" android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
