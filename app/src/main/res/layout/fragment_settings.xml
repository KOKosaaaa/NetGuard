                    <RadioButton android:id="@+id/rb_per_app_disabled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/per_app_disabled" />
                    <RadioButton android:id="@+id/rb_per_app_whitelist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/per_app_whitelist" />
                    <RadioButton android:id="@+id/rb_per_app_blacklist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/per_app_blacklist" />
                </RadioGroup>
