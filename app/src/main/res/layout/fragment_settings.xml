                <LinearLayout android:id="@+id/section_trigger" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/trigger_title" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="2dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/trigger_subtitle" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="8dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_open_trigger" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trigger_pick_apps" style="@style/Widget.Material3.Button.OutlinedButton" />
