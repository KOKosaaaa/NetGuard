                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_connection_map" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/show_connection_map" android:minHeight="48dp" android:paddingVertical="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/connection_map_desc" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"  android:layout_marginBottom="4dp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_speed_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/show_speed_test" android:minHeight="48dp" android:paddingVertical="4dp" />
