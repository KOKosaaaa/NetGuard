                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_telemost_striping" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/telemost_striping" android:minHeight="48dp" android:paddingVertical="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/telemost_striping_desc" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"  android:layout_marginBottom="4dp" />
