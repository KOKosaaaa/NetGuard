                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/security_test_desc" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="8dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_security_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/run_security_test" />
