                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/per_app_vpn" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/per_app_desc" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="8dp" />
