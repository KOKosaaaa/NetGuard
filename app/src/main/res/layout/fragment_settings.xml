                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_bypass_ips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="@string/bypass_ips_hint">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_bypass_ips" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="2" android:gravity="top" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" app:cardCornerRadius="24dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_desc" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="8dp" />
                <RadioGroup android:id="@+id/rg_routing" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/rb_auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_auto" />
                    <RadioButton android:id="@+id/rb_global" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_global" />
                    <RadioButton android:id="@+id/rb_rules" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_rules" />
                    <RadioButton android:id="@+id/rb_direct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_direct" />
                </RadioGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/routing_auto_desc" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" app:cardCornerRadius="24dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DNS" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dns_desc" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="8dp" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/primary_dns">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_primary_dns" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/secondary_dns">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_secondary_dns" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" app:cardCornerRadius="24dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_doh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/doh" android:minHeight="48dp" android:paddingVertical="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/doh_desc" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"  android:layout_marginBottom="4dp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_bypass_lan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bypass_lan" android:minHeight="48dp" android:paddingVertical="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/bypass_lan_desc" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"  android:layout_marginBottom="4dp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_ipv6" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enable_ipv6" android:minHeight="48dp" android:paddingVertical="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ipv6_desc" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"  android:layout_marginBottom="4dp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_speed_notification" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/show_speed_notification" android:minHeight="48dp" android:paddingVertical="4dp" />
