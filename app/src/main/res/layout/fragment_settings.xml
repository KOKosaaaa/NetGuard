                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_tls_fragment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tls_fragment_enable" android:minHeight="48dp" android:paddingVertical="4dp" />
                <LinearLayout android:id="@+id/ll_tls_fragment_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginStart="16dp" android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tls_fragment_packets">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_tls_packets" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:text="tlshello" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tls_fragment_length">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_tls_length" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:text="100-200" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tls_fragment_interval">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_tls_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:text="10-20" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" app:cardCornerRadius="24dp" app:cardElevation="0dp">
