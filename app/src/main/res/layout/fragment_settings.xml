                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_auto_switch_throttle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auto_switch_throttle" android:minHeight="48dp" android:paddingVertical="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_switch_throttle_desc" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"  android:layout_marginBottom="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_traffic_stats_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/traffic_stats" style="@style/Widget.Material3.Button.OutlinedButton" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/traffic_stats_desc" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"  android:layout_marginBottom="4dp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_auto_connect_wifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auto_connect_wifi" android:minHeight="48dp" android:paddingVertical="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_connect_wifi_desc" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"  android:layout_marginBottom="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_trusted_wifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trusted_wifi"  style="@style/Widget.Material3.Button.OutlinedButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" app:cardCornerRadius="24dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cb_local_dpi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/local_dpi_enable" android:minHeight="48dp" android:paddingVertical="4dp" />
