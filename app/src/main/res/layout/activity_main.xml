<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.smarttools.netguard.widget.LiquidBackdrop
        android:id="@+id/liquid_backdrop"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:paddingVertical="4dp"
        android:background="@android:color/transparent"
        app:itemHorizontalTranslationEnabled="false"
        app:itemTextAppearanceActive="@style/TextAppearance.NetGuard.Navigation"
        app:itemTextAppearanceInactive="@style/TextAppearance.NetGuard.Navigation"
        app:menu="@menu/bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- fsociety boot-sequence overlay. Hidden by default; MainActivity
         makes it VISIBLE only on first launch of the activity (savedInstanceState=null)
         when the active theme is FSOCIETY. After ~1.8s it fades out and is
         set back to GONE. Constrained to fill the whole window. -->
    <TextView
        android:id="@+id/boot_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF000000"
        android:fontFamily="monospace"
        android:textColor="#FF00FF41"
        android:textSize="11sp"
        android:padding="16dp"
        android:gravity="top|start"
        android:visibility="gone"
        android:focusable="false"
        android:clickable="false"
        android:elevation="32dp"
        android:translationZ="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
