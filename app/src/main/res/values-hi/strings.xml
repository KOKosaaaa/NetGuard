    <string name="srv_profiles_empty_how_body">1. «प्रोफ़ाइल बनाएँ» दबाएँ।\n2. प्रोटोकॉल और किस साइट के रूप में छिपना है चुनें।\n3. 30 सेकंड में प्रोफ़ाइल तैयार — यह अपने आप होम स्क्रीन पर दिखेगी, आप कनेक्ट कर सकते हैं।</string>
    <string name="srv_profiles_empty_how_title">यह कैसे काम करता है</string>
    <string name="srv_profiles_empty_title">यहाँ आपकी VPN प्रोफ़ाइलें होंगी</string>
    <string name="srv_proto_telemost_badge">YA</string>
    <string name="srv_proto_telemost_desc">＋ «BS मोड» में भी काम करता है, जब सामान्य VPN ब्लॉक हो।\n－ VLESS से धीमा और सर्वर व फ़ोन पर काफ़ी ज़्यादा लोड डालता है।\nट्रैफ़िक को असली Telemost कॉन्फ़्रेंस के अंदर छिपाता है। केवल NetGuard।</string>
    <string name="srv_proto_telemost_title">वीडियो कॉन्फ़्रेंस (Telemost)</string>
    <string name="srv_proto_vless_desc">＋ तेज़, सर्वर और फ़ोन पर लगभग लोड नहीं। किसी बड़ी साइट के रूप में छिपता है।\n－ «BS मोड» में काम नहीं करता, जब ऑपरेटर IP पतों के आधार पर रोकता है।\nNetGuard, Hiddify, v2rayNG, Streisand के लिए उपयुक्त।</string>
    <string name="srv_proto_vless_title">VLESS + REALITY · अनुशंसित</string>
