diff --git a/src/hev-socks5-session.c b/src/hev-socks5-session.c
index e946fa6..8bce2de 100644
--- a/src/hev-socks5-session.c
+++ b/src/hev-socks5-session.c
@@ -8,20 +8,37 @@
  */
 
 #include <string.h>
+#include <stdio.h>
 
 #include "hev-utils.h"
+#include "hev-compiler.h"
 #include "hev-logger.h"
 #include "hev-config.h"
 #include "hev-socks5-client.h"
 
 #include "hev-socks5-session.h"
 
+/* Authenticated loopback-only metadata for Android connection-owner lookup.
+ * LWIP's remote endpoint is the original application's local socket. */
+void
+hev_socks5_session_set_origin (HevSocks5SessionData *data, int protocol,
+    const ip_addr_t *source, unsigned int source_port,
+    const ip_addr_t *destination, unsigned int destination_port)
+{
+    char src[48], dst[48];
+    ipaddr_ntoa_r (source, src, sizeof (src));
+    ipaddr_ntoa_r (destination, dst, sizeof (dst));
+    snprintf (data->origin, sizeof (data->origin), "|%d|%s|%u|%s|%u",
+              protocol, src, source_port, dst, destination_port);
+}
+
 void
 hev_socks5_session_run (HevSocks5Session *self)
 {
     HevSocks5SessionIface *iface;
     HevConfigServer *srv;
     int res;
+    char origin_user[256];
 
     LOG_D ("%p socks5 session run", self);
 
@@ -35,9 +52,15 @@ hev_socks5_session_run (HevSocks5Session *self)
     }
 
     if (srv->user && srv->pass) {
-        hev_socks5_client_set_auth (HEV_SOCKS5_CLIENT (self), srv->user,
-                                    srv->pass);
-        LOG_D ("%p socks5 client auth %s:%s", self, srv->user, srv->pass);
+        const char *user = srv->user;
+        if (strncmp (user, "ngsrc-", 6) == 0) {
+            HevListNode *node = hev_socks5_session_get_node (self);
+            HevSocks5SessionData *data = container_of (node, HevSocks5SessionData, node);
+            if (snprintf (origin_user, sizeof (origin_user), "%s%s", user, data->origin) >= sizeof (origin_user))
+                return;
+            user = origin_user;
+        }
+        hev_socks5_client_set_auth (HEV_SOCKS5_CLIENT (self), user, srv->pass);
     }
 
     res = hev_socks5_client_handshake (HEV_SOCKS5_CLIENT (self), srv->pipeline);
